  <!-- 导航平面参考沿用导出模型原点；不加入旧模型的安装高度。 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <!-- Point-LIO: p_IMU = R_LI * p_LiDAR + T_LI。此处为其逆变换。
       与实车 nav2_params.yaml 的 mapping.extrinsic_T/R 一致，非底盘安装外参。 -->
  <link name="mid360_imu"/>
  <joint name="mid360_to_imu" type="fixed">
    <parent link="mid360_link"/>
    <child link="mid360_imu"/>
    <origin xyz="0.011 0.02329 -0.04412" rpy="0 0 0"/>
  </joint>
  <!-- 保留 CAD 坐标与安装外参；用零位姿别名兼容原导航配置。 -->
  <link name="gimbal_yaw"/>
  <joint name="yaw_link_to_gimbal_yaw" type="fixed">
    <parent link="yaw_link"/>
    <child link="gimbal_yaw"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="front_mid360"/>
  <joint name="mid360_link_to_front_mid360" type="fixed">
    <parent link="mid360_link"/>
    <child link="front_mid360"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <!-- gimbal_yaw_fake 由 fake_vel_transform 根据里程计动态发布，不在 URDF 固定。 -->
