<?xml version="1.0"?>
<package format="3">
  <name>lc_passage_nav2</name>
  <version>1.0.0</version>
  <description>TDT passage global planner plugin for ROS2 Humble / Nav2.</description>
  <maintainer email="yyj051101@outlook.com">HBUT LC RoboMaster</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>
  <depend>eigen</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>lc_passage_msgs</depend>
  <depend>lc_passage_common</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/global_planner_plugin.xml"/>
  </export>
</package>
