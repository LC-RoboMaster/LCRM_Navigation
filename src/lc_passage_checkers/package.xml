<?xml version="1.0"?>
<package format="3">
  <name>lc_passage_checkers</name>
  <version>1.0.0</version>
  <description>Nav2 passage-aware progress and goal checker plugins.</description>
  <maintainer email="yyj051101@outlook.com">HBUT LC RoboMaster</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lc_passage_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/checkers_plugin.xml"/>
  </export>
</package>
